#!/usr/bin/env node
// Docker consumes this stdout directly. Never invoke the helper interactively.
import {execFileSync} from 'node:child_process';
if(process.argv[2]!=="get")process.exit(1);
let input="";
for await (const part of process.stdin)input+=part;
if(!["cr.yandex","https://cr.yandex"].includes(input.trim()))process.exit(1);
try {
  const token=execFileSync("yc",["iam","create-token","--profile","default"],{encoding:"utf8",stdio:["ignore","pipe","ignore"]}).trim();
  process.stdout.write(JSON.stringify({Username:"iam",Secret:token}));
} catch {process.exit(1);}
